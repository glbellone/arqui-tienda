{
  "realm": "tiendas",
  "enabled": true,
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Supervisa la plataforma"
      },
      {
        "name": "duenio",
        "description": "Administra su tienda"
      },
      {
        "name": "comprador",
        "description": "Compra en las tiendas"
      }
    ]
  },
  "clients": [
    {
      "clientId": "tiendas-web",
      "name": "Frontend web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "protocolMappers": [
        {
          "name": "tienda_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tienda_id",
            "claim.name": "tienda_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      }
    }
  ],
